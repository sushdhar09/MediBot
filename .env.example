# Copy to .env and fill in. Required.
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
MEDIBOT_SECRET_KEY=change-me-in-production
MEDIBOT_HYBRID_CANDIDATES=10
MEDIBOT_RERANK_TOP_K=3
MEDIBOT_CORS_ORIGINS=http://localhost:8501
MEDIBOT_API_BASE=http://127.0.0.1:8000

# Guardrails (input + output). Deterministic checks always run; the OpenEvals
# judge only runs when they are inconclusive.
MEDIBOT_GUARDRAILS_ENABLED=true
MEDIBOT_GUARDRAIL_JUDGE_ENABLED=true
MEDIBOT_GUARDRAIL_MODEL=llama-3.1-8b-instant
MEDIBOT_GUARDRAIL_JUDGE_TIMEOUT=12
# A malformed verdict always blocks. This only covers a judge that cannot be
# reached at all: true = keep the deterministic verdict and log at ERROR,
# false = block everything until the judge is back.
MEDIBOT_GUARDRAIL_FALLBACK_DETERMINISTIC=true

# Optional AWS Bedrock Guardrails layer - leave the id blank to keep it off.
MEDIBOT_BEDROCK_GUARDRAIL_ID=
MEDIBOT_BEDROCK_GUARDRAIL_VERSION=DRAFT
MEDIBOT_BEDROCK_REGION=ap-south-1
